    "TableOfContents": "  items: { id: string; label: string; level?: 1 | 2 }[];\n  sticky?: boolean;\n  tone?: 'light' | 'dark';\n  className?: string;",
    "ColumnsSection": "  eyebrow?: string;\n  title?: string;\n  subtitle?: string;\n  titleFullWidth?: boolean;\n  layout?: 'single' | 'split';\n  mediaType?: 'image' | 'video' | 'shortcode';\n  image?: { image: { url: string; alt?: string; width?: number; height?: number }; alt?: string; width?: number; height?: number };\n  /** Rendered instead of `image` when present, or when `image` holds a video URL. */\n  video?: { src?: string; sources?: { src: string; type?: string }[]; poster?: string; width?: number; height?: number; autoPlay?: boolean; loop?: boolean; muted?: boolean; controls?: boolean };\n  shortCode?: string;\n  className?: string;"
